      "displayName": "retail_sales_dataset",
      "config": {
        "version": "1.1",
        "source": "retail.`retail-sales`.retail_sales_dataset",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "Day Type",
            "expr": "CASE WHEN DAYOFWEEK(Date) IN (1, 7) THEN 'Weekend' ELSE 'Weekday' END"
          },
          {
            "name": "Day Name",
            "expr": "DATE_FORMAT(Date, 'EEEE')"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
